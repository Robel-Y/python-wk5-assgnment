class Smartphone:
    def __init__(self, brand, model, storage_gb, color):
        self.brand = brand
        self.model = model
        self.storage_gb = storage_gb
        self.color = color
    
    def make_call(self, number):
        print(f"Calling {number} using {self.brand} {self.model}...")
    
    def take_photo(self):
        print(f"{self.brand} {self.model} is taking a photo!")

# Inheritance example: Smartphone subclass for a specific OS
class AndroidPhone(Smartphone):
    def __init__(self, brand, model, storage_gb, color, android_version):
        super().__init__(brand, model, storage_gb, color)
        self.android_version = android_version
    
    def install_app(self, app_name):
        print(f"Installing {app_name} from Google Play Store on {self.model}.")

# Create a phone instance
my_phone = AndroidPhone("Samsung", "Galaxy S21", 128, "Phantom Gray", "11")
my_phone.make_call("123-456-7890")
my_phone.take_photo()
my_phone.install_app("WhatsApp")
